# ---------- クライアント公開OK（NEXT_PUBLIC_） ----------
# Supabase 接続情報。未設定でもローカルのフォールバックデータで診断は動作する。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 公開URL（OGP画像の絶対URL生成に使用。未設定時はリクエストのoriginを使う）
NEXT_PUBLIC_SITE_URL=

# ---------- サーバ専用（絶対にNEXT_PUBLIC_を付けない） ----------
# 承認画面（/admin）が使う service_role キー。RLSをバイパスするため取り扱い注意。
SUPABASE_SERVICE_ROLE_KEY=

# 承認画面のアクセストークン。/admin?token=<この値> でアクセスする。
# 十分に長いランダム文字列にすること（例: openssl rand -hex 24）
ADMIN_TOKEN=
